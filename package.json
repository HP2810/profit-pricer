{
  "name": "profit-pricer-desktop",
  "productName": "Profit Pricer",
  "version": "1.0.0",
  "description": "Offline eBay selling-price calculator",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.local.profitpricer",
    "productName": "Profit Pricer",
    "files": [
      "main.js",
      "app/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "ProfitPricer.exe"
    }
  }
}
